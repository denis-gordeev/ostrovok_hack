# LLM агента подбора отелей: "<провайдер>:<модель>" в формате langchain init_chat_model.
# Для другого провайдера поставьте его пакет (например, uv add langchain-openai) и ключ.
HOTEL_LLM_MODEL=anthropic:claude-opus-5-5
# Метод structured output для извлечения интентов (сейчас отключено): json_schema | function_calling | json_mode
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
ANTHROPIC_API_KEY=
# OpenRouter: HOTEL_LLM_MODEL=openrouter:<модель с openrouter.ai, например deepseek/deepseek-v4-flash-0731>
# OPENROUTER_API_KEY=

# Трасса агента в терминале: вызовы LLM (токены, в т.ч. на размышление) и tools, итог каждого хода
AGENT_TRACE=true
# Папка для JSONL-трасс (файл на запуск); пусто — трасса только в терминале
AGENT_TRACE_DIR=traces

# Сбор данных островка (uv run ostrovok-scrape)
OSTROVOK_DB_DSN=postgresql://ostrovok:ostrovok@localhost:5433/ostrovok
# Тесты с БД; без переменной они пропускаются
OSTROVOK_TEST_DSN=postgresql://ostrovok:ostrovok@localhost:5433/ostrovok_test

# Шум Казани (uv run kazan-noise)
KAZAN_NOISE_DATA_DIR=data/kazan_noise

# События Казани с KudaGo (uv run kudago-events). Агент сам загружает их в фоне при запуске, если данным больше суток.
# API KudaGo отвечает 403 с иностранных IP: нужен российский IP или HTTPS_PROXY.
KUDAGO_DB_DSN=postgresql://ostrovok:ostrovok@localhost:5433/ostrovok
# KUDAGO_HORIZON_DAYS=60
# KUDAGO_MAX_AGE_HOURS=24

# Гео-агент Казани (agent.py, geo_api.py): LLM через OpenAI-совместимый API
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Base URL of an OpenAI-compatible API (without /chat/completions):
LLM_API_URL=https://api.openai.com/v1
CACHE_DIR=.cache
# Conversation history budget (approximate tokens; system prompt is additional).
CONTEXT_MAX_TOKENS=16000
CONTEXT_SUMMARY_TOKENS=1024
# Logical calls per user turn, excluding automatic network retries.
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=48
AGENT_MAX_CALLS_PER_TOOL=12
OVERPASS_URL=https://overpass-api.de/api
# OSMnx HTTP API for walking routes (local or deployed server):
OSMNX_API_URL=http://127.0.0.1:8080
# Used by geo_api.py for local public transport; Compose overrides these:
OTP_URL=http://127.0.0.1:8090
TRANSIT_DATA_DIR=.cache/transit
REQUEST_TIMEOUT=90
# Disable only for your own Overpass server:
OVERPASS_RATE_LIMIT=true
# Local encyclopedia retrieval; no paid embedding API.
EMBEDDINGS_URL=http://127.0.0.1:8082
WIKIPEDIA_DATA_DIR=.cache/wikipedia/ruwiki-20261001

# Optional model for purpose-based Wikipedia summaries; defaults to LLM_MODEL.
WIKIPEDIA_SUMMARY_MODEL=

# Transient HTTP failures only, 1–10 total attempts per Overpass request.
OVERPASS_MAX_ATTEMPTS=6
# Independent tools run concurrently in a single model step.
AGENT_MAX_CONCURRENCY=8
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_CACHE_SECONDS=21600
WEB_SEARCH_BACKEND=bing,duckduckgo
