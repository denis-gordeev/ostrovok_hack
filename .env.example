LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Base URL of an OpenAI-compatible API (without /chat/completions):
LLM_API_URL=https://api.openai.com/v1
CACHE_DIR=.cache
OVERPASS_URL=https://overpass-api.de/api
# OSMnx HTTP API for walking routes (local or deployed server):
OSMNX_API_URL=http://127.0.0.1:8080
# Used by geo_api.py for local public transport; Compose overrides these:
OTP_URL=http://127.0.0.1:8090
TRANSIT_DATA_DIR=.cache/transit
REQUEST_TIMEOUT=90
# Disable only for your own Overpass server:
OVERPASS_RATE_LIMIT=true
