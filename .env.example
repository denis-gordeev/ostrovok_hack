# LLM агента: "<провайдер>:<модель>" в формате langchain init_chat_model.
# Для другого провайдера поставьте его пакет (например, uv add langchain-openai) и ключ.
LLM_MODEL=anthropic:claude-opus-5-5
# Метод structured output для извлечения интентов (сейчас отключено): json_schema | function_calling | json_mode
LLM_STRUCTURED_OUTPUT_METHOD=json_schema
ANTHROPIC_API_KEY=
# OpenRouter: LLM_MODEL=openrouter:<модель с openrouter.ai, например deepseek/deepseek-v4-flash-0731>
# OPENROUTER_API_KEY=

# Трасса агента в терминале: вызовы LLM (токены, в т.ч. на размышление) и tools, итог каждого хода
AGENT_TRACE=true
# Папка для JSONL-трасс (файл на запуск); пусто — трасса только в терминале
AGENT_TRACE_DIR=traces

# Сбор данных островка (uv run ostrovok-scrape)
OSTROVOK_DB_DSN=postgresql://ostrovok:ostrovok@localhost:5433/ostrovok
# Тесты с БД; без переменной они пропускаются
OSTROVOK_TEST_DSN=postgresql://ostrovok:ostrovok@localhost:5433/ostrovok_test

# Шум Казани (uv run kazan-noise)
KAZAN_NOISE_DATA_DIR=data/kazan_noise

# События Казани с KudaGo (uv run kudago-events). Агент сам загружает их в фоне при запуске, если данным больше суток.
# API KudaGo отвечает 403 с иностранных IP: нужен российский IP или HTTPS_PROXY.
KUDAGO_DB_DSN=postgresql://ostrovok:ostrovok@localhost:5433/ostrovok
# KUDAGO_HORIZON_DAYS=60
# KUDAGO_MAX_AGE_HOURS=24
